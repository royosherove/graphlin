    "@vscode/tree-sitter-wasm": "0.3.1"
  },
  "bundledDependencies": [
    "@vscode/tree-sitter-wasm"
  ],
  "exports": {
    "./extensions/sdk": {
      "types": "./runtime/extensions/sdk.d.ts",
